  "components": {
    "schemas": {
      "CreateCategoryRequest": {
        "required": [
          "categoryName",
          "categoryType"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "categoryType": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "eventID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateEnrolmentRequest": {
        "type": "object",
        "properties": {
          "eventID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "categoryID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateEventRequest": {
        "required": [
          "distance",
          "eventDate",
          "eventName",
          "eventType",
          "location"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "event_Discrip": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "distance": {
            "maximum": 999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "location": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateResultRequest": {
        "required": [
          "finishTime"
        ],
        "type": "object",
        "properties": {
          "enrolmentID": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "minLength": 1,
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,7})?$",
            "type": "string"
          },
          "finishPosition": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateEnrolmentStatusRequest": {
        "required": [
          "enrolment_status"
        ],
        "type": "object",
        "properties": {
          "enrolment_status": {
            "minLength": 1,
            "pattern": "^(Pending|Confirmed|Cancelled)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateEventRequest": {
        "required": [
          "distance",
          "eventDate",
          "eventName",
          "eventType",
          "location"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "event_Discrip": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "distance": {
            "maximum": 999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "location": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter your JWT token. Example: Bearer eyJhbGciOi...",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
